# Copy to .env and fill in. .env is gitignored — never commit real keys.
# On GitHub, add the same names under Settings -> Secrets and variables -> Actions.

# Glide: Data editor -> any table -> Show API -> the Bearer token
GLIDE_TOKEN=

# exchangerate-api.com key (the part after /v6/ in the Glide Call API URL)
EXCHANGE_RATE_API_KEY=

# Card "days elapsed" uses the local weekday, like your users' browsers in India
TZ=Asia/Kolkata

# Optional: if set, the data needs ?k=<ACCESS_KEY> in the page URL (use it in the Glide Web Embed URL)
ACCESS_KEY=
